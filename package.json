{
  "name": "pi-pff-prisema",
  "version": "0.1.0",
  "description": "PFFPrisema: Prisema-safe FFF search extension for Pi, optimized for long-running agent sessions.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "fff",
    "search",
    "prisema",
    "pff-prisema"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ff-labs/fff-node": "0.6.4"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.72.1",
    "@types/node": "^22.15.30",
    "typebox": "^1.1.24",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  }
}
